{:paths ["scripts" "test"]
 :tasks
 {:requires ([validate]
             [publish]
             [bump-versions]
             [cursor-plugin])

  validate {:doc "Validate plugin structure (Copilot + Cursor paths, frontmatter, L4 drift)"
            :task (validate/validate!)}

  test {:doc "Run publish unit tests"
        :task (do (require 'publish-test :reload)
                  (let [{:keys [fail error]} (clojure.test/run-tests 'publish-test)]
                    (System/exit (if (zero? (+ fail error)) 0 1))))}

  generate-cursor-plugins {:doc "Generate .cursor-plugin/ manifests from Copilot sources"
                           :task (cursor-plugin/generate-cursor-plugins!)}

  publish {:doc "Promote the current tree to public master and bump private next"
           :task (publish/publish! {:dry-run (some #{"--dry-run"} *command-line-args*)})}

  ci-release {:doc "Write changelog, versions, and generated marketplace files for a release"
              :task (let [version (first *command-line-args*)]
                      (when-not version
                        (println "Usage: bb ci-release <version>")
                        (System/exit 1))
                      (bump-versions/bump-versions! {})
                      (bump-versions/generate-readmes!)
                      (publish/ci-release! version)
                      (publish/generate-marketplace-plugins!)
                      (cursor-plugin/generate-cursor-plugins!)
                      (publish/update-readme!))}

  update-readme {:doc "Regenerate marketplace.json plugins, Cursor manifests, and README.md table"
                 :task (do (publish/generate-marketplace-plugins!)
                           (cursor-plugin/generate-cursor-plugins!)
                           (publish/update-readme!))}

  bump-version {:doc "Bump marketplace version without changelog changes"
                :task (let [version (first *command-line-args*)]
                        (when-not version
                          (println "Usage: bb bump-version <version>")
                          (System/exit 1))
                        (publish/bump-version! version))}

  bump-plugin-versions {:doc "Bump plugin.json versions for plugins with content changes since last version bump"
                        :task (bump-versions/bump-versions!
                               {:dry-run (some #{"--dry-run"} *command-line-args*)})}

  generate-plugin-readmes {:doc "Generate README.md for each plugin from plugin.json and skill/agent frontmatter"
                           :task (bump-versions/generate-readmes!)}}}
